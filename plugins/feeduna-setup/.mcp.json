{
  "mcpServers": {
    "feeduna": {
      "command": "node",
      "args": [
        "--disallow-code-generation-from-strings",
        "./feeduna-mcp.cjs"
      ],
      "env": {
        "FEEDUNA_API_URL": "https://app.feeduna.com",
        "FEEDUNA_ALLOW_LOCAL_HTTP": "0"
      },
      "env_vars": [
        "FEEDUNA_API_TOKEN"
      ],
      "enabled_tools": [
        "feeduna_get_setup"
      ],
      "startup_timeout_sec": 60,
      "cwd": "."
    }
  }
}
